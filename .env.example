# ============================================================
# Пример конфигурации. Скопируйте в .env (он в .gitignore)
# и замените значения.
#
# Значения ниже — ЗАГЛУШКИ, а не рабочие секреты; реальные
# ключи в репозиторий не кладутся.
# ============================================================

# ---------- PostgreSQL bootstrap ----------
POSTGRES_USER=postgres
POSTGRES_DB=course

# bootstrap-roles.sh и docker-compose.yml требуют все пароли явно
# (${VAR:?required}); без них `docker compose up` не запустится.
# Для локальной разработки оставьте значения-заглушки, для
# реального деплоя — замените на свои.
COURSE_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
COURSE_AUTOCHECK_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# ---------- JWT (C# services: api, cli, gateway, worker-a, worker-b) ----------
COURSE_JWT_ISSUER=moduledev-course
COURSE_JWT_AUDIENCE=moduledev-api
# HS256: минимум 32 байта, рекомендуется 64 hex-символа.
COURSE_JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARS

# ---------- Пароли LOGIN-ролей PostgreSQL ----------
# Заводит postgres-init/00-bootstrap-roles.sh.
COURSE_MIGRATOR_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
COURSE_PUBLISHER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
COURSE_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
COURSE_WORKER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# Если Cli/Program.cs читает отдельное имя для bootstrap роли
# workflow_worker — значение обязано совпадать с COURSE_WORKER_PASSWORD.
COURSE_WORKFLOW_WORKER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

COURSE_OUTBOX_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
COURSE_INBOX_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# ---------- Provider / dispatcher (значения по умолчанию) ----------
PROVIDER_URL=http://provider-simulator:8081
OUTBOX_OWNER=outbox-dispatcher
OUTBOX_OWNER_B=outbox-dispatcher-b
RECEIPT_API_URL=http://gateway:8080/api/receipt/accept

# ---------- Provider / receipt-adapter ----------
PROVIDER_HMAC_SECRET=REPLACE_WITH_RANDOM_HMAC_SECRET
PROVIDER_CALLBACK_CAPABILITY=REPLACE_WITH_UNPREDICTABLE_PATH_SEGMENT
PROVIDER_CALLBACK_TOKEN=REPLACE_WITH_CALLBACK_JWT
PROVIDER_AUDIT_TOKEN=REPLACE_WITH_AUDIT_TOKEN

# ---------- Gateway ----------
# Единственный host-порт, публикуется только на 127.0.0.1.
COURSE_GATEWAY_PORT=8080
GATEWAY_URL=http://gateway:8080

# ---------- Test profile / failpoints ----------
COURSE_TEST_PROFILE=1
# Пусто = failpoint выключен. Допустимые имена — в README,
# раздел «Аварийные сценарии».
COURSE_FAILPOINT=

# ---------- Необязательные переопределения (значения test profile) ----------
# COURSE_PROVIDER_TIMEOUT_MS=500
# COURSE_OUTBOX_POLL_MS=100
# COURSE_OUTBOX_LEASE_MS=2000
# COURSE_OUTBOX_MAX_ATTEMPTS=4
# COURSE_OUTBOX_BACKOFF_BASE_MS=200
# COURSE_OUTBOX_BACKOFF_MAX_MS=800
# COURSE_OUTBOX_JITTER_MAX_MS=100
# COURSE_INBOX_POLL_MS=500
# COURSE_JOB_LEASE_MS=2000
# COURSE_WORKER_POLL_MS=100