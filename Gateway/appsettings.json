{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "actions-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{module}/{action}",
          "Methods": [ "POST" ]
        }
      },
      "openapi-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/openapi/{**rest}",
          "Methods": [ "GET" ]
        }
      },
      "health-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/health/{**rest}",
          "Methods": [ "GET" ]
        }
      },
      "metrics-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/metrics",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api-destination": {
            "Address": "http://api:8080/"
          }
        }
      }
    }
  }
}